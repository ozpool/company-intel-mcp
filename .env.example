# Port the HTTP server listens on
PORT=3000
# Interface to bind. 127.0.0.1 keeps the server local; use 0.0.0.0 inside a container
HOST=127.0.0.1
# Public base URL clients use to reach this server (used for OAuth metadata and export links).
# Its hostname is also the only non-loopback Host header the server accepts.
# PUBLIC_URL=http://localhost:3000   (defaults to http://localhost:$PORT)
# SQLite database file
DATABASE_PATH=data/app.db
# Secret for signing export download links. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXPORT_SIGNING_SECRET=
# Requests per minute allowed per API key / OAuth client
RATE_LIMIT_PER_MINUTE=60
# How long export download links stay valid, in minutes
EXPORT_TTL_MINUTES=15
# trace | debug | info | warn | error | silent
LOG_LEVEL=info
