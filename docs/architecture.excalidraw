, "height": 23, "text": "what the client sends and what comes back \u00b7 failures are tool results the model can read", "fontSize": 18, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "text", "id": "text_116", "x": 0, "y": 1000, "width": 441, "height": 117, "text": "POST /mcp\nAuthorization: Bearer aik_\u2026\n{ \"method\": \"tools/call\",\n  \"params\": { \"name\": \"search_companies\",\n    \"arguments\": { \"query\": \"AI companies\",\n                   \"country\": \"AU\", \"limit\": 10 } } }", "fontSize": 15, "fontFamily": 5}, {"type": "arrow", "id": "arrow_117", "x": 420, "y": 1060, "width": 120, "height": 0, "points": [[0, 0], [120, 0]], "endArrowhead": "arrow", "strokeWidth": 2, "strokeColor": "#2f9e44"}, {"type": "text", "id": "text_118", "x": 488.0, "y": 1036.0, "width": 27, "height": 18, "text": "200", "fontSize": 14, "fontFamily": 5, "strokeColor": "#2f9e44"}, {"type": "text", "id": "text_119", "x": 560, "y": 1000, "width": 466, "height": 117, "text": "{ \"structuredContent\": {\n    \"results\": [{ \"id\": \"cmp_1\", \"name\": \"Tidal AI\",\n      \"industry\": \"Artificial Intelligence\",\n      \"employees\": 397, \"country\": \"Australia\" }, \u2026],\n    \"total\": 6 },\n  \"content\": [{ \"type\": \"text\", \"text\": \"same JSON\" }] }", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_120", "x": 1120, "y": 1000, "width": 466, "height": 136, "text": "get_company { \"companyId\": \"cmp_9999\" }\n\u2192 isError: true\n{ \"error\": { \"code\": \"NOT_FOUND\",\n    \"message\": \"Company 'cmp_9999' does not exist\" } }\n\ncountry \"Narnia\" \u2192 VALIDATION_ERROR + knownCountries\nlimit 500 \u2192 plain text \"Input validation error: \u2026\" (SDK)", "fontSize": 15, "fontFamily": 5, "strokeColor": "#e03131"}, {"type": "text", "id": "text_121", "x": 1680, "y": 1000, "width": 251, "height": 78, "text": "export_contacts \u2192 downloadUrl\n/exports/exp_\u2026.csv?exp=\u2026&sig=\u2026\nHMAC over id + expiry\n403 forged \u00b7 410 expired", "fontSize": 15, "fontFamily": 5}, {"type": "text", "id": "text_122", "x": 0, "y": 1260, "width": 202, "height": 46, "text": "DATA MODEL", "fontSize": 36, "fontFamily": 5}, {"type": "text", "id": "text_123", "x": 0, "y": 1308, "width": 954, "height": 23, "text": "SQLite tables \u00b7 dashed = account link without a SQL foreign key \u00b7 secrets stored only as SHA-256", "fontSize": 18, "fontFamily": 5, "strokeColor": "#495057"}, {"type": "rectangle", "id": "rectangle_124", "x": 0, "y": 1380, "width": 300, "height": 210, "strokeWidth": 2, "strokeColor": "#1971c2", "backgroundColor": "#ffffff", "roundness": {"type": 3}}, {"type": "rectangle", "id": "rectangle_125", "x": 3, "y": 1383, "width": 294, "height": 34, "strokeWidth": 1, "strokeColor": "transparent", "backgroundColor": "#1971c214", "roundness": {"type": 3}}, {"type": "line", "id": "line_126", "x": 0, "y": 1418, "width": 300, "height": 0, "strokeWidth": 1, "strokeColor": "#1971c2", "points": [[0, 0], [300, 0]]}, {"type": "text", "id": "text_127", "x": 12, "y": 1389, "width": 88, "height": 22, "text": "companies", "fontSize": 17, "fontFamily": 1, "strokeColor": "#1e1e1e"}, {"type": "image", "id": "image_128", "x": 270, "y": 1389, "width": 20, "height": 20.0, "fileId": "file_building-2_1971c2", "status": "saved", "scale": [1, 1], "strokeColor": "transparent", "backgroundColor": "transparent"}, {"type": "text", "id": "text_129", "x": 12, "y": 1424, "width": 19, "height": 18, "text": "id", "fontSize": 14, "fontFamily": 1, "strokeColor": "#1971c2"}, {"type": "text", "id": "text_130", "x": 237.95, "y": 1425, "width": 54, "height": 16, "text": "text pk", "fontSize": 13, "fontFamily": 5, "strokeColor": "#1971c2"}, {"type": "line", "id": "line_131", "x": 8, "y": 1446, "width": 284, "height": 0, "strokeWidth": 1, "strokeColor": "#e9ecef", "points": [[0, 0], [284, 0]]}, {"type": "text", "id": "text_132", "x": 12, "y": 1452, "width": 34, "height": 18, "text": "name", "fontSize": 14, "fontFamily": 1, "strokeColor": "#