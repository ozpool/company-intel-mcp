{
  "name": "company-intel-mcp",
  "version": "1.0.0",
  "description": "MCP server for a Company Intelligence Platform: search companies, contacts, enrich and export.",
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch --import tsx src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "seed": "node --disable-warning=ExperimentalWarning --import tsx scripts/seed.ts",
    "demo": "node --disable-warning=ExperimentalWarning --import tsx scripts/demo-client.ts",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
